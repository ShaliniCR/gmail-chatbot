# Anthropic Claude API Key (Required for /api/chat)
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic Model (Optional, defaults to claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# TrainerCentral API Key (Optional header x-api-key)
TRAINER_API_KEY=your_trainer_api_key_here

# TrainerCentral Dashboard API Base URL (Optional, defaults to production dashboard)
DASHBOARD_API_BASE=https://trainer-central-assigments-api.onrender.com
